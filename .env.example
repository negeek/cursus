# Where the application finds its database.
# This hostname is the compose service name, so it resolves inside the
# container network. Running the binary directly on your machine instead means
# pointing this at 127.0.0.1.
DATABASE_URL=postgres://cursus:cursus@cursus-db:5432/cursus

# Signs and verifies JWTs. The application will not start without it.
# Use a long random value and keep it out of version control. Changing it
# invalidates every token already issued, so everyone signs in again.
SECRET=change-me-to-a-long-random-secret

# Where the tests connect. They run on your machine rather than inside the
# container network, so this points at the published port instead of the
# service name. Falls back to DATABASE_URL when unset, which only works if that
# is host reachable too.
# Each test clones its own database from a migrated template, so this only
# needs to name a server the tests may create databases on.
TEST_DATABASE_URL=postgres://cursus:cursus@127.0.0.1:5432/cursus

# Optional. Shown with the values assumed when they are not set.
# HOST=0.0.0.0
# PORT=8080
# WORKERS=4
# LOG_LEVEL=info
